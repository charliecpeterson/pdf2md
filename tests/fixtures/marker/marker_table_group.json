    {
     "id": "/page/0/Text/12",
     "block_type": "Text",
     "html": "<p block-type=\"Text\">Notes: IM= Internal Marketing; IBE= Internal Brand Equity; BO= Brand Orientation; JS= Job Satisfaction;**p&lt;0.01; *&lt;0.05</p>",
     "polygon": [
      [
       68.53999999999999,
