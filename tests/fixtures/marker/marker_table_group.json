    {
     "id": "/page/0/SectionHeader/6",
     "block_type": "SectionHeader",
     "html": "<h2><i>Sampling and Data collection:</i></h2>",
     "polygon": [
      [
       68.53999999999999,
       222.288
      ],
      [
       195.488,
       222.288
      ],
      [
       195.488,
       235.2913818359375
      ],
      [
       68.53999999999999,
       235.2913818359375
      ]
     ],
     "bbox": [
      68.53999999999999,
      222.288,
      195.488,
