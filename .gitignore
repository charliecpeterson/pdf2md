# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
build/
dist/
.eggs/

# Virtualenvs
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# docsmcp output (transcriptions, sqlite, rendered images)
out/
# Blind-corpus bundles live outside the working corpus on purpose: scripts
# scan `out/`, so keeping them here is what stops a spent-but-separate corpus
# being promoted into the QA gate by a script's choice of directory.
out-blind-*/

# Local experiment and audit scratch
tmp/

# Local claim-checking field test. The report itself is public (see notes/);
# its corpus quotes source text that is not ours to redistribute.
/scripts/eval_claim_checking.py
/tests/claim_checking_corpus.json
/tests/test_eval_claim_checking.py

# The labelled corpus: copyrighted journal PDFs that cannot be redistributed.
# Keep them outside the tree and point PDF2MD_CORPUS at them (docs/qa-corpus.md);
# this rule is the safety net, not the arrangement.
/*.pdf

# Local env / secrets
.env
.env.local
.envrc

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# stray R history
.Rhistory
out-cuda36/
out-cuda36b/
out-cuda36c/
out-cuda36d/
out-cuda36e/
