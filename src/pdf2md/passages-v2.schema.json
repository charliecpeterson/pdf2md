{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/charliecpeterson/pdf2md/main/src/pdf2md/passages-v2.schema.json",
  "title": "pdf2md passage schema v2",
  "description": "Stable retrieval passages with explicit source and review provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "content_hash",
    "document",
    "section_breadcrumb",
    "display_text",
    "retrieval_text",
    "content_types",
    "markdown",
    "sources",
    "previous_id",
    "next_id",
    "authority",
    "review",
    "assets",
    "tokenizer",
    "split"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "id": {"type": "string", "pattern": "^passage-[0-9a-f]{20}$"},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "key", "title", "authors", "language"],
      "properties": {
        "id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "key": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "title": {"type": "string"},
        "authors": {"type": "array", "items": {"type": "string"}},
        "language": {"type": "string", "minLength": 2}
      }
    },
    "section_breadcrumb": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "depth", "kind"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "depth": {"type": "integer", "minimum": 0},
          "kind": {
            "enum": ["front_matter", "part", "chapter", "section", "appendix"]
          }
        }
      }
    },
    "display_text": {"type": "string", "minLength": 1},
    "retrieval_text": {"type": "string", "minLength": 1},
    "content_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "heading", "paragraph", "list", "table", "figure", "equation",
          "code", "caption", "footnote", "other"
        ]
      }
    },
    "markdown": {"type": ["string", "null"]},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "previous_id": {"type": ["string", "null"]},
    "next_id": {"type": ["string", "null"]},
    "authority": {"enum": ["text", "source_image"]},
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["needs_review", "dispositions"],
      "properties": {
        "needs_review": {"type": "boolean"},
        "dispositions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["action_required", "source_dependent", "informational"]
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {"$ref": "#/$defs/asset"}
    },
    "tokenizer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "count", "limit"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "count": {"type": "integer", "minimum": 1},
        "limit": {"type": "integer", "minimum": 1}
      }
    },
    "split": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "count"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "count": {"type": "integer", "minimum": 1}
      }
    }
  },
  "$defs": {
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x0", "y0", "x1", "y1"],
      "properties": {
        "x0": {"type": "number"},
        "y0": {"type": "number"},
        "x1": {"type": "number"},
        "y1": {"type": "number"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block_id", "page", "bbox", "source_page", "role"],
      "properties": {
        "block_id": {"type": "string"},
        "page": {"type": "integer", "minimum": 1},
        "bbox": {"oneOf": [{"$ref": "#/$defs/bbox"}, {"type": "null"}]},
        "source_page": {"type": "string"},
        "role": {"enum": ["primary", "caption", "context"]}
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "type", "provenance"],
      "properties": {
        "path": {"type": "string"},
        "type": {
          "enum": [
            "source_crop", "source_page_image", "figure_image", "figure_svg",
            "chart_data", "reproduction_code", "table_candidate", "table_csv",
            "table_json", "table_normalized_csv", "table_normalized_json",
            "table_cell_evidence"
          ]
        },
        "provenance": {
          "enum": [
            "source_render", "engine_derived", "deterministic_derived", "model_derived"
          ]
        }
      }
    }
  }
}
